# Managed deployment injects DATABASE_URL and the built-in model service credentials.
# For standalone local development, use development credentials in your local .env only;
# never commit real database, model-service or owner identity values.
DATABASE_URL=mysql://user:password@host:3306/geotwinai
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
GEOTWIN_PUBLIC_ORIGIN=
# Compatibility aliases for the existing starter's legacy LLM configuration.
MANUS_API_URL=
MANUS_API_KEY=
# Exact signed-in project owner's Manus OpenID; store only in the protected Webdev secrets flow.
OWNER_OPEN_ID=
PORT=3000
