# Managed deployment injects DATABASE_URL and the built-in model service credentials.
# For standalone local development, use a development database and keep .env private.
# Never commit real database, model-service, owner email or account ID values.
DATABASE_URL=mysql://user:password@host:3306/geotwinai
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
GEOTWIN_PUBLIC_ORIGIN=
# Compatibility aliases for the existing starter's legacy LLM configuration.
MANUS_API_URL=
MANUS_API_KEY=
# Both owner settings must point to the same registered account; store them only in protected settings.
GEOTWIN_OWNER_EMAIL=
GEOTWIN_OWNER_ACCOUNT_ID=
PORT=3000
